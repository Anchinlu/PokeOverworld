{
  "$schema": "https://raw.githubusercontent.com/nickkraakman/tauri/refs/heads/dev/crates/tauri-cli/config.schema.json",
  "productName": "PokeOverworld",
  "version": "0.1.0",
  "identifier": "com.pokeoverworld.preview",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../.. run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PokeOverworld",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' http://localhost:5173; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
