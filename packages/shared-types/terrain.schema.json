{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-game.local/schema/terrain.schema.json",
  "title": "Terrain",
  "description": "Shared terrain identifiers and walkability metadata.",
  "type": "object",
  "required": ["id", "name", "walkable", "footstepSurface"],
  "properties": {
    "id": { "type": "integer", "enum": [0, 1, 2, 3, 4, 5] },
    "name": { "type": "string", "minLength": 1 },
    "walkable": { "type": "boolean" },
    "footstepSurface": { "type": "string", "enum": ["none", "grass", "dirt", "sand", "rock"] },
    "blocksTrees": { "type": "boolean", "default": false },
    "blocksMovement": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
